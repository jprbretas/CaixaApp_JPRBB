@page "/pedidos/{Numero}"
@rendermode InteractiveServer
@using CaixaProjeto.Core.Contratos
@using CaixaProjeto.Core.Dominio
@using CaixaProjeto.Web.Services
@inject CreditoApiClient Api

@* InteractiveServer: a página tem botões (Aprovar / Recusar), e os cliques são tratados
   no servidor através de uma ligação em tempo real (SignalR). *@

<PageTitle>Pedido @Numero</PageTitle>

<a href="pedidos" class="d-inline-block mb-3">&larr; Voltar à lista</a>

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}
else if (!carregado)
{
    <p class="text-muted">A carregar...</p>
}
else if (detalhe is null)
{
    <div class="alert alert-warning">O pedido <strong>@Numero</strong> não existe.</div>
}
else
{
    <div class="d-flex align-items-center gap-3 mb-3">
        <h1 class="mb-0">Pedido @detalhe.Numero</h1>
        <span class="badge fs-6 text-bg-@Formatos.CorDecisao(detalhe.EstadoAtual)">@detalhe.EstadoAtual.Texto()</span>
    </div>

    @if (mensagemSucesso is not null)
    {
        <div class="alert alert-success">@mensagemSucesso</div>
    }

    @if (detalhe.AguardaAnalista)
    {
        <div class="card border-warning mb-4">
            <div class="card-header bg-warning bg-opacity-25">Este pedido aguarda a decisão de um analista</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="analista">Analista</label>
                        <input id="analista" class="form-control" maxlength="100" @bind="nomeAnalista" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" for="observacao">Observação (porque aprova ou recusa)</label>
                        <textarea id="observacao" class="form-control" rows="2" maxlength="500" @bind="observacao"></textarea>
                    </div>
                </div>

                @if (erroDecisao is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@erroDecisao</div>
                }

                <div class="mt-3">
                    <button type="button" class="btn btn-success" disabled="@aDecidir" @onclick="() => DecidirAsync(true)">Aprovar</button>
                    <button type="button" class="btn btn-danger" disabled="@aDecidir" @onclick="() => DecidirAsync(false)">Recusar</button>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">Dados do pedido</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-7">Data de submissão</dt>
                        <dd class="col-5 text-end">@Formatos.DataHora(detalhe.DataSubmissao)</dd>
                        <dt class="col-7">NIF</dt>
                        <dd class="col-5 text-end">@(detalhe.Dados.Nif ?? "-")</dd>
                        <dt class="col-7">Idade</dt>
                        <dd class="col-5 text-end">@detalhe.Dados.Idade anos</dd>
                        <dt class="col-7">Rendimento mensal líquido</dt>
                        <dd class="col-5 text-end">@Formatos.Euros(detalhe.Dados.RendimentoMensalLiquido)</dd>
                        <dt class="col-7">Prestações atuais</dt>
                        <dd class="col-5 text-end">@Formatos.Euros(detalhe.Dados.PrestacoesAtuais)</dd>
                        <dt class="col-7">Valor pretendido</dt>
                        <dd class="col-5 text-end">@Formatos.Euros(detalhe.Dados.ValorPretendido)</dd>
                        <dt class="col-7">Prazo</dt>
                        <dd class="col-5 text-end">@detalhe.Dados.PrazoMeses meses</dd>
                        <dt class="col-7">Situação profissional</dt>
                        <dd class="col-5 text-end">@TextoSituacao(detalhe.Dados.SituacaoProfissional)</dd>
                        <dt class="col-7">Incidentes de crédito</dt>
                        <dd class="col-5 text-end">@(detalhe.Dados.IncidentesCredito ? "Sim" : "Não")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <h6 class="text-muted">Análise automática</h6>
            <ResultadoView Resultado="detalhe.Resultado" />
        </div>
    </div>

    <h4 class="mt-4">Histórico de estados</h4>
    <div class="table-responsive">
        <table class="table align-middle text-nowrap">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>De</th>
                    <th>Para</th>
                    <th>Utilizador</th>
                    <th>Observação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var linha in detalhe.Historico)
                {
                    <tr>
                        <td>@Formatos.DataHora(linha.Data)</td>
                        <td>
                            @if (linha.EstadoAnterior is not null)
                            {
                                <span class="badge text-bg-@Formatos.CorDecisao(linha.EstadoAnterior.Value)">@linha.EstadoAnterior.Value.Texto()</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td><span class="badge text-bg-@Formatos.CorDecisao(linha.EstadoNovo)">@linha.EstadoNovo.Texto()</span></td>
                        <td>@linha.Utilizador</td>
                        <td>@linha.Observacao</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    // Vem do URL: /pedidos/20260001 -> Numero = "20260001"
    [Parameter] public string Numero { get; set; } = "";

    private PedidoDetalhe? detalhe;
    private bool carregado;
    private string? erro;

    // Formulário do analista
    private string nomeAnalista = "";
    private string observacao = "";
    private string? erroDecisao;
    private string? mensagemSucesso;
    private bool aDecidir;

    // OnParametersSetAsync (e não OnInitializedAsync) para voltar a carregar se o número no URL mudar
    protected override async Task OnParametersSetAsync()
    {
        erro = null;
        try
        {
            detalhe = await Api.ObterAsync(Numero);
        }
        catch (HttpRequestException ex)
        {
            detalhe = null;
            erro = MensagensErro.Para(ex);
        }
        carregado = true;
    }

    private async Task DecidirAsync(bool aprovar)
    {
        erroDecisao = null;

        // Validação aqui para uma resposta imediata; a API volta a validar, porque é ela que manda
        if (string.IsNullOrWhiteSpace(nomeAnalista) || string.IsNullOrWhiteSpace(observacao))
        {
            erroDecisao = "Indique o nome do analista e a observação.";
            return;
        }

        aDecidir = true;
        try
        {
            var erroApi = await Api.DecidirAsync(Numero, new DecisaoAnalista(aprovar, nomeAnalista, observacao));
            if (erroApi is not null)
            {
                erroDecisao = erroApi;
                return;
            }

            // Correu bem: volta a ler o pedido, para mostrar o estado novo e a linha nova do histórico
            detalhe = await Api.ObterAsync(Numero);
            if (aprovar)
            {
                mensagemSucesso = "Pedido aprovado.";
            }
            else
            {
                mensagemSucesso = "Pedido recusado.";
            }
            observacao = "";
        }
        catch (HttpRequestException ex)
        {
            erroDecisao = MensagensErro.Para(ex);
        }
        finally
        {
            aDecidir = false;
        }
    }

    private static string TextoSituacao(SituacaoProfissional? situacao)
    {
        if (situacao is null)
        {
            return "-";
        }
        return situacao.Value.Texto();
    }
}
