<div class="cabecalho-pagina">
    <div>
        @if (Eyebrow is not null)
        {
            <p class="eyebrow">@Eyebrow</p>
        }
        <h1>@Titulo</h1>
        @if (Descricao is not null)
        {
            <p class="cabecalho-pagina-descricao">@Descricao</p>
        }
    </div>
    @if (ChildContent is not null)
    {
        <div class="cabecalho-pagina-acoes">@ChildContent</div>
    }
</div>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Descricao { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
